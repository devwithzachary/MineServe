# Copy this file to scripts/.macos-builder.env and set MACOS_HOST to your Mac Studio SSH target.
# Make sure "Remote Login" (SSH) is enabled on the Mac Studio:
#   System Settings -> General -> Sharing -> Remote Login

MACOS_HOST="zachary@mac-studio.local"
MACOS_REPO_DIR="~/Code/MineServe-macbuild"
MACOS_SSH_OPTS="-i $HOME/.ssh/id_ed25519_mineserve -o IdentitiesOnly=yes"
MACOS_WEB_PORT="18081"

# Tip: Run ./scripts/build_macos_remote.sh --setup-ssh once to authorize the key for passwordless builds.
