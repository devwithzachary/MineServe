# Maintainer: Zachary <https://github.com/devwithzachary/MineServe>
pkgname=mineserve
pkgver=1.8.0
pkgrel=1
pkgdesc="Native Linux Minecraft Java, Modded, Proxy, and Bedrock Server Manager (Desktop GUI & Headless Web UI)"
arch=('x86_64' 'aarch64')
url="https://github.com/devwithzachary/MineServe"
license=('GPL-3.0-or-later')
depends=('java-runtime>=21' 'hicolor-icon-theme')
optdepends=(
    'python-dbus: Native KDE Plasma / Wayland StatusNotifierItem system tray integration'
    'python-gobject: GLib event loop for native D-Bus system tray'
    'xdg-utils: Open server directories and Web Admin URLs in desktop browser'
)
source=("MineServe-${pkgver}-linux-portable-nojre.tar.gz")
sha256sums=('SKIP')

package() {
    install -d "${pkgdir}/opt/mineserve"
    cp -r "${srcdir}/MineServe-${pkgver}-linux-portable-nojre/"* "${pkgdir}/opt/mineserve/"

    install -d "${pkgdir}/usr/bin"
    ln -sf "/opt/mineserve/bin/mineserve" "${pkgdir}/usr/bin/mineserve"

    install -Dm644 "${srcdir}/MineServe-${pkgver}-linux-portable-nojre/share/mineserve.desktop" \
        "${pkgdir}/usr/share/applications/mineserve.desktop"
    install -Dm644 "${srcdir}/MineServe-${pkgver}-linux-portable-nojre/share/mineserve.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/mineserve.png"
    install -Dm644 "${srcdir}/MineServe-${pkgver}-linux-portable-nojre/share/mineserve.service" \
        "${pkgdir}/usr/lib/systemd/system/mineserve.service"
}
